aws_region          = "ap-south-1"
admin_cidr          = "203.0.113.10/32"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Phase 0 permits public HTTPS so EDGE-001 can connect from changing NAT IPs.
# Replace this with known customer/NAT CIDRs when practical.
edge_https_cidrs = ["0.0.0.0/0"]

# Optional overrides:
# availability_zone     = "ap-south-1a"
# instance_type         = "t3.medium"
# root_volume_size_gib  = 60
